# Copy to .env.local (never committed) for a local build. SETUP.md, step 5.
# Everything starting with VITE_ is shipped to the browser: never put the
# service_role or secret key here.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Build switches, off unless set to 1. The deploy workflow sets neither.
VITE_CLOUD_ACCOUNTS=
VITE_OFFLINE_SHELL=
